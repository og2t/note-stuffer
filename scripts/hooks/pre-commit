#!/bin/sh
# Sets the release patch number to this commit's number, and cache-busts the assets with it
cd "$(git rev-parse --show-toplevel)" || exit 1
n=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
perl -pi -e "s/(RELEASE = '\d+\.\d+\.)\d+/\${1}$n/" version.js
perl -pi -e "s/\?v=\d+/?v=$n/g" index.html
git add version.js index.html
